<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Response Code Grouping Test">
      <stringProp name="TestPlan.comments">Tests that errors are grouped by response code only, not by response message. Same code with different messages should merge into one row in Error Summary.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Mixed Response Messages">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,2)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,20)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/orders" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
Thread.sleep(random.nextInt(50, 200))

// 200 with varying messages
def messages200 = [&quot;OK&quot;, &quot;Success&quot;, &quot;Fine&quot;, &quot;Completed&quot;]
// 500 with varying messages
def messages500 = [&quot;Internal Server Error&quot;, &quot;Backend Failure&quot;, &quot;Database Error&quot;, &quot;Service Crashed&quot;]
// 400 with varying messages
def messages400 = [&quot;Bad Request&quot;, &quot;Invalid Input&quot;, &quot;Malformed JSON&quot;]

def roll = random.nextInt(100)
if (roll &lt; 60) {
    // 60% — RC 200, random message
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(messages200[random.nextInt(messages200.size())])
    SampleResult.setResponseData(&apos;{&quot;status&quot;:&quot;ok&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 85) {
    // 25% — RC 500, random message
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(messages500[random.nextInt(messages500.size())])
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;server error&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    // 15% — RC 400, random message
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;400&quot;)
    SampleResult.setResponseMessage(messages400[random.nextInt(messages400.size())])
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;bad request&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">200</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/payments" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
Thread.sleep(random.nextInt(100, 400))

// 200 with varying messages
def messages200 = [&quot;OK&quot;, &quot;Accepted&quot;, &quot;Payment Processed&quot;]
// 502 with varying messages
def messages502 = [&quot;Bad Gateway&quot;, &quot;Upstream Error&quot;, &quot;Gateway Timeout Retry&quot;]
// 404 with varying messages
def messages404 = [&quot;Not Found&quot;, &quot;Resource Missing&quot;, &quot;No Such Endpoint&quot;]

def roll = random.nextInt(100)
if (roll &lt; 50) {
    // 50% — RC 200, random message
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(messages200[random.nextInt(messages200.size())])
    SampleResult.setResponseData(&apos;{&quot;status&quot;:&quot;ok&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 75) {
    // 25% — RC 502, random message
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;502&quot;)
    SampleResult.setResponseMessage(messages502[random.nextInt(messages502.size())])
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;bad gateway&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    // 25% — RC 404, random message
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;404&quot;)
    SampleResult.setResponseMessage(messages404[random.nextInt(messages404.size())])
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;not found&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(128)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
      </hashTree>
      <com.jmeterwebinsightreport.report.listener.WebInsightReportListener guiclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListenerGui" testclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListener" testname="Web Insight Report">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
      </com.jmeterwebinsightreport.report.listener.WebInsightReportListener>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
