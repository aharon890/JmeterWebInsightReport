<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Long Names Test — Edge Case">
      <stringProp name="TestPlan.comments">Edge case test with very long sampler names (100+ characters). Validates report UI handles long labels without breaking layout.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Long Name Users">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,3)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,20)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v3/enterprise/organizations/{orgId}/departments/{deptId}/employees/{empId}/performance-reviews?year=2026&amp;quarter=Q1&amp;includeGoals=true&amp;expand=manager,peers" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(100, 300)
Thread.sleep(delay)

// 3% error rate
if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Failed to fetch performance reviews&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;reviews&quot;:[{&quot;rating&quot;:4.5,&quot;quarter&quot;:&quot;Q1&quot;}],&quot;goals&quot;:3,&quot;manager&quot;:&quot;John Doe&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(96)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v3/enterprise/workforce-management/schedules/{scheduleId}/shifts/bulk-create?timezone=America/Los_Angeles&amp;validate=true&amp;notifyEmployees=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(150, 400)
Thread.sleep(delay)

// 5% error rate
if (random.nextInt(100) &lt; 5) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;400&quot;)
    SampleResult.setResponseMessage(&quot;Bad Request&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Shift overlap detected for employee EMP-4521&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;201&quot;)
    SampleResult.setResponseMessage(&quot;Created&quot;)
    SampleResult.setResponseData(&apos;{&quot;created&quot;:15,&quot;skipped&quot;:0,&quot;notifications&quot;:&quot;sent&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(512)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PUT /api/v3/enterprise/human-resources/benefits/enrollment/{enrollmentId}/dependents/add?effectiveDate=2026-04-01&amp;planType=medical&amp;coverageTier=family" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(80, 250)
Thread.sleep(delay)

// 2% error rate
if (random.nextInt(100) &lt; 2) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;422&quot;)
    SampleResult.setResponseMessage(&quot;Unprocessable Entity&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Dependent SSN already enrolled in another plan&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;enrollmentId&quot;:&quot;ENR-7890&quot;,&quot;dependentsAdded&quot;:2,&quot;effectiveDate&quot;:&quot;2026-04-01&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(256)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="DELETE /api/v3/enterprise/asset-management/devices/{deviceId}/decommission?reason=end-of-life&amp;transferData=true&amp;notifyIT=true&amp;createTicket=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(50, 200)
Thread.sleep(delay)

// 4% error rate
if (random.nextInt(100) &lt; 4) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;409&quot;)
    SampleResult.setResponseMessage(&quot;Conflict&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Device has pending data transfer, cannot decommission&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;deviceId&quot;:&quot;DEV-3456&quot;,&quot;status&quot;:&quot;decommissioned&quot;,&quot;ticketId&quot;:&quot;IT-98765&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(80)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PATCH /api/v3/enterprise/project-management/portfolios/{portfolioId}/projects/{projectId}/milestones/{milestoneId}/update-status?newStatus=completed&amp;notifyStakeholders=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(60, 180)
Thread.sleep(delay)

// 3% error rate
if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;404&quot;)
    SampleResult.setResponseMessage(&quot;Not Found&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Milestone not found in specified project&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;milestoneId&quot;:&quot;MS-456&quot;,&quot;status&quot;:&quot;completed&quot;,&quot;stakeholdersNotified&quot;:8}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(128)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
      </hashTree>
      <com.jmeterwebinsightreport.report.listener.WebInsightReportListener guiclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListenerGui" testclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListener" testname="Web Insight Report">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
