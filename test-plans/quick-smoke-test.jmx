        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/identity/oauth2/token?grant_type=authorization_code&amp;redirect_uri=https://app.example.com/callback">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(200, 500)
Thread.sleep(delay)

// 3% error rate
if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;401&quot;)
    SampleResult.setResponseMessage(&quot;Unauthorized&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Invalid credentials&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;token&quot;:&quot;eyJhbGciOiJIUzI1NiJ9.mock&quot;,&quot;expiresIn&quot;:3600}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(256)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
