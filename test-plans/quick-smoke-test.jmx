        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/shopping-cart/{cartId}/items/add?applyPromotions=true&amp;loyaltyProgram=GOLD&amp;shippingEstimate=true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(100, 400)
Thread.sleep(delay)

// 3% error rate
if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;409&quot;)
    SampleResult.setResponseMessage(&quot;Conflict&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Item out of stock&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    def cartTotal = String.format(&quot;%.2f&quot;, random.nextDouble(10.0, 500.0))
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;cartId&quot;:&quot;cart-001&quot;,&quot;items&quot;:&apos; + random.nextInt(1,5) + &apos;,&quot;total&quot;:&apos; + cartTotal + &apos;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(192)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">400</stringProp>
            <stringProp name="RandomTimer.range">600</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/orders/checkout/process-payment?provider=stripe&amp;method=card&amp;3dsecure=required&amp;idempotencyKey={uuid}">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
// Checkout is the slowest — 300-1200ms with payment processing
def delay = random.nextInt(300, 800)
if (random.nextInt(100) &lt; 15) { delay += random.nextInt(300, 600) } // 15% slow payment processing
Thread.sleep(delay)

// 8% error rate — payment failures, timeouts
def roll = random.nextInt(100)
if (roll &lt; 4) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;402&quot;)
    SampleResult.setResponseMessage(&quot;Payment Required&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Payment declined&quot;,&quot;code&quot;:&quot;CARD_DECLINED&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 8) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Payment gateway timeout&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    def orderId = &quot;ORD-&quot; + System.currentTimeMillis() + &quot;-&quot; + random.nextInt(1000)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;201&quot;)
    SampleResult.setResponseMessage(&quot;Created&quot;)
    SampleResult.setResponseData(&apos;{&quot;orderId&quot;:&quot;&apos; + orderId + &apos;&quot;,&quot;status&quot;:&quot;confirmed&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(512)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
