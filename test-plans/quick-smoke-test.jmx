<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Quick Smoke Test — E-Commerce API Simulation">
      <stringProp name="TestPlan.comments">Quick test (10 users, 30s) for validating the Web Insight Report plugin. Uses JSR223 Samplers to simulate API calls with varied response times and error rates.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_DELAY" elementType="Argument">
            <stringProp name="Argument.name">BASE_DELAY</stringProp>
            <stringProp name="Argument.value">50</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Browse &amp; Search Users">
        <stringProp name="ThreadGroup.num_threads">${__P(threads_browse,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,5)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,30)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/marketplace/homepage/featured-products?category=electronics&amp;sortBy=popularity&amp;limit=24&amp;includeReviews=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(80, 250)
Thread.sleep(delay)

// 1% error rate
if (random.nextInt(100) &lt; 1) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Homepage service temporarily unavailable&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;page&quot;:&quot;home&quot;,&quot;featured_products&quot;:12,&quot;banners&quot;:3}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(128)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">500</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&amp;minRating=4.5&amp;verified=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def queries = [&quot;laptop&quot;, &quot;phone&quot;, &quot;headphones&quot;, &quot;monitor&quot;, &quot;keyboard&quot;, &quot;mouse&quot;, &quot;tablet&quot;, &quot;camera&quot;, &quot;speaker&quot;, &quot;charger&quot;]
def query = queries[random.nextInt(queries.size())]

// Search is heavier — 150-800ms with occasional spikes
def delay = random.nextInt(150, 600)
if (random.nextInt(100) &lt; 10) { delay += random.nextInt(200, 500) } // 10% chance of slow query
Thread.sleep(delay)

// 5% error rate
if (random.nextInt(100) &lt; 5) {
    SampleResult.setSuccessful(false)
    if (random.nextBoolean()) {
        SampleResult.setResponseCode(&quot;504&quot;)
        SampleResult.setResponseMessage(&quot;Gateway Timeout&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Search service timeout&quot;,&quot;query&quot;:&quot;&apos; + query + &apos;&quot;}&apos;, &quot;UTF-8&quot;)
    } else {
        SampleResult.setResponseCode(&quot;503&quot;)
        SampleResult.setResponseMessage(&quot;Service Unavailable&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Search index rebuilding&quot;,&quot;query&quot;:&quot;&apos; + query + &apos;&quot;}&apos;, &quot;UTF-8&quot;)
    }
} else {
    def resultCount = random.nextInt(0, 150)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;query&quot;:&quot;&apos; + query + &apos;&quot;,&quot;results&quot;:&apos; + resultCount + &apos;,&quot;page&quot;:1}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(96)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
            <stringProp name="RandomTimer.range">700</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/catalog/products/{productId}/variants?includeInventory=true&amp;warehouse=US-WEST-2&amp;currency=USD" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def productId = random.nextInt(1, 500)
def delay = random.nextInt(50, 300)
Thread.sleep(delay)

// 2% error rate (product not found)
if (random.nextInt(100) &lt; 2) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;404&quot;)
    SampleResult.setResponseMessage(&quot;Not Found&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Product not found&quot;,&quot;id&quot;:&apos; + productId + &apos;}&apos;, &quot;UTF-8&quot;)
} else {
    def price = String.format(&quot;%.2f&quot;, random.nextDouble(9.99, 1999.99))
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;id&quot;:&apos; + productId + &apos;,&quot;name&quot;:&quot;Product &apos; + productId + &apos;&quot;,&quot;price&quot;:&apos; + price + &apos;,&quot;inStock&quot;:true}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">200</stringProp>
            <stringProp name="RandomTimer.range">500</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>
      </hashTree>
