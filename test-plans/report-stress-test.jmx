<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Report Stress Test — 20 Samplers, 10 Error Types">
      <stringProp name="TestPlan.comments">Stress test for Web Insight Report: 20 samplers with long names, 10 distinct error types, varied response times and throughput patterns.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ========== Thread Group 1: API Gateway & Auth (5 samplers) ========== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="API Gateway &amp; Authentication Flow">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,8)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,10)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- Sampler 1 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v3/identity/oauth2/authorize?response_type=code&amp;client_id=webapp-prod&amp;scope=openid+profile+email&amp;redirect_uri=https://dashboard.example.com/auth/callback&amp;state={csrfToken}" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
Thread.sleep(r.nextInt(100, 350))
if (r.nextInt(100) &lt; 4) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;401&quot;)
    SampleResult.setResponseMessage(&quot;Unauthorized — Invalid client_id or redirect_uri mismatch&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;invalid_client&quot;,&quot;error_description&quot;:&quot;The OAuth client was not found or redirect_uri does not match registered callbacks&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;302&quot;)
    SampleResult.setResponseMessage(&quot;Found&quot;)
    SampleResult.setResponseData(&apos;{&quot;redirect&quot;:&quot;https://dashboard.example.com/auth/callback?code=abc123&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(200, 400))
SampleResult.setConnectTime(r.nextInt(5, 25))
SampleResult.setLatency(r.nextInt(20, 80))
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">200</stringProp>
            <stringProp name="RandomTimer.range">400</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- Sampler 2 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v3/identity/oauth2/token?grant_type=authorization_code&amp;code_verifier={pkceVerifier}&amp;redirect_uri=https://dashboard.example.com/auth/callback" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
Thread.sleep(r.nextInt(150, 500))
if (r.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;400&quot;)
    SampleResult.setResponseMessage(&quot;Bad Request — Authorization code expired or already used&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;invalid_grant&quot;,&quot;error_description&quot;:&quot;The authorization code has expired. Authorization codes are valid for 10 minutes.&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;access_token&quot;:&quot;eyJ...mock&quot;,&quot;token_type&quot;:&quot;Bearer&quot;,&quot;expires_in&quot;:3600,&quot;refresh_token&quot;:&quot;rt_mock&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(300, 600))
SampleResult.setConnectTime(r.nextInt(5, 30))
SampleResult.setLatency(r.nextInt(30, 100))
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">200</stringProp>
            <stringProp name="RandomTimer.range">300</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- Sampler 3 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v3/users/me/profile?include=preferences,notifications,subscriptions&amp;expand=organization,teams,roles&amp;fields=all" enabled="true">
