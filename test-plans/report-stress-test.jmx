        <!-- Sampler 9 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v3/marketplace/catalog/products/{productId}/reviews?includePhotos=true&amp;verifiedPurchaseOnly=false&amp;moderationLevel=auto" enabled="true">
