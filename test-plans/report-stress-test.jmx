        <!-- Sampler 4 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PUT /api/v3/users/me/preferences/notification-settings?channels=email,push,sms&amp;timezone=America/Los_Angeles&amp;locale=en-US&amp;digestFrequency=daily" enabled="true">
