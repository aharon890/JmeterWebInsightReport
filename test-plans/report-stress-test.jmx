        <!-- Sampler 10 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v3/marketplace/recommendations/personalized?userId={userId}&amp;algorithm=collaborative-filtering&amp;maxItems=12&amp;excludeViewed=true&amp;boostCategory=recent-purchases" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
def delay = r.nextInt(150, 600)
if (r.nextInt(100) &lt; 8) delay += r.nextInt(200, 600) // ML model latency spikes
Thread.sleep(delay)
if (r.nextInt(100) &lt; 2) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error — ML recommendation model failed to score candidates&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;model_inference_error&quot;,&quot;model_version&quot;:&quot;v2.7.3&quot;,&quot;message&quot;:&quot;TensorFlow Serving returned status UNAVAILABLE&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;recommendations&quot;:[],&quot;model&quot;:&quot;cf-v2.7&quot;,&quot;count&quot;:12}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(100, 220))
SampleResult.setConnectTime(r.nextInt(5, 30))
SampleResult.setLatency(r.nextInt(25, 100))
          </stringProp>
