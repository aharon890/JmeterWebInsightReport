        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- Sampler 6 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v3/marketplace/catalog/products/search?query={searchTerm}&amp;category=electronics&amp;minPrice=10&amp;maxPrice=5000&amp;sortBy=relevance&amp;page=1&amp;pageSize=48&amp;facets=brand,rating,shipping" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
def delay = r.nextInt(200, 700)
if (r.nextInt(100) &lt; 12) delay += r.nextInt(300, 800) // slow queries
Thread.sleep(delay)
def roll = r.nextInt(100)
if (roll &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;504&quot;)
    SampleResult.setResponseMessage(&quot;Gateway Timeout — Elasticsearch cluster did not respond within 30s deadline&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;search_timeout&quot;,&quot;message&quot;:&quot;Elasticsearch query exceeded 30000ms deadline. Cluster health: YELLOW, active shards: 47/50&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 5) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;503&quot;)
    SampleResult.setResponseMessage(&quot;Service Unavailable — Search index is being rebuilt after schema migration&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;index_rebuilding&quot;,&quot;eta_seconds&quot;:120,&quot;progress&quot;:&quot;67%&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;totalResults&quot;:&apos; + r.nextInt(0, 5000) + &apos;,&quot;page&quot;:1,&quot;results&quot;:[],&quot;facets&quot;:{}}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(100, 250))
SampleResult.setConnectTime(r.nextInt(5, 35))
SampleResult.setLatency(r.nextInt(30, 120))
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">300</stringProp>
            <stringProp name="RandomTimer.range">500</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- Sampler 7 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v3/marketplace/catalog/products/{productId}/details?includeReviews=true&amp;reviewsLimit=25&amp;includeQA=true&amp;includeSimilar=true&amp;currency=USD&amp;warehouse=US-WEST-2" enabled="true">
