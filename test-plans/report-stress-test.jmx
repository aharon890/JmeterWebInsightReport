        <!-- Sampler 5 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="DELETE /api/v3/identity/sessions/current?revokeRefreshTokens=true&amp;logoutFromAllDevices=false&amp;clearBrowserCookies=true&amp;auditReason=user_initiated" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
