          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
Thread.sleep(r.nextInt(50, 250))
if (r.nextInt(100) &lt; 4) {
    if (r.nextBoolean()) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseCode(&quot;429&quot;)
        SampleResult.setResponseMessage(&quot;Too Many Requests — SendGrid API rate limit exceeded (100 emails/sec)&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;rate_limited&quot;,&quot;provider&quot;:&quot;sendgrid&quot;,&quot;limit&quot;:100,&quot;retry_after_ms&quot;:1500}&apos;, &quot;UTF-8&quot;)
    } else {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseCode(&quot;502&quot;)
        SampleResult.setResponseMessage(&quot;Bad Gateway — Push notification provider (FCM) returned invalid response&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;push_delivery_failed&quot;,&quot;provider&quot;:&quot;FCM&quot;,&quot;message&quot;:&quot;Firebase Cloud Messaging returned HTTP 500 for batch delivery&quot;}&apos;, &quot;UTF-8&quot;)
    }
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;202&quot;)
    SampleResult.setResponseMessage(&quot;Accepted&quot;)
    SampleResult.setResponseData(&apos;{&quot;batchId&quot;:&quot;NB-&apos; + r.nextInt(1000,9999) + &apos;&quot;,&quot;queued&quot;:3,&quot;channels&quot;:[&quot;email&quot;,&quot;push&quot;,&quot;sms&quot;]}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(150, 400))
SampleResult.setConnectTime(r.nextInt(3, 20))
SampleResult.setLatency(r.nextInt(10, 50))
