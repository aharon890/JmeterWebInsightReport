          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
def delay = r.nextInt(400, 1000)
if (r.nextInt(100) &lt; 15) delay += r.nextInt(500, 1500) // 3DS challenge
Thread.sleep(delay)
def roll = r.nextInt(100)
if (roll &lt; 5) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;402&quot;)
    SampleResult.setResponseMessage(&quot;Payment Required — Card declined by issuing bank (insufficient funds)&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;payment_declined&quot;,&quot;decline_code&quot;:&quot;insufficient_funds&quot;,&quot;message&quot;:&quot;The card was declined. Please try a different payment method.&quot;,&quot;stripe_error_id&quot;:&quot;err_1N...&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 8) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error — Payment gateway timeout during 3D Secure authentication&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;gateway_timeout&quot;,&quot;provider&quot;:&quot;stripe&quot;,&quot;message&quot;:&quot;3DS authentication timed out after 30s. Transaction rolled back.&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;201&quot;)
    SampleResult.setResponseMessage(&quot;Created&quot;)
    SampleResult.setResponseData(&apos;{&quot;paymentId&quot;:&quot;pi_&apos; + r.nextInt(100000,999999) + &apos;&quot;,&quot;status&quot;:&quot;succeeded&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(400, 800))
SampleResult.setConnectTime(r.nextInt(10, 50))
SampleResult.setLatency(r.nextInt(50, 200))
          </stringProp>
