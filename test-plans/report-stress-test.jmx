          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
def delay = r.nextInt(300, 800)
if (r.nextInt(100) &lt; 10) delay += r.nextInt(500, 1500) // label printer queue
Thread.sleep(delay)
def roll = r.nextInt(100)
if (roll &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;503&quot;)
    SampleResult.setResponseMessage(&quot;Service Unavailable — Warehouse management system offline for maintenance window&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;wms_offline&quot;,&quot;warehouse&quot;:&quot;US-WEST-2&quot;,&quot;maintenance_window&quot;:&quot;02:00-04:00 UTC&quot;,&quot;message&quot;:&quot;WMS is undergoing scheduled maintenance. Orders will be queued.&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 5) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;409&quot;)
    SampleResult.setResponseMessage(&quot;Conflict — Order already fulfilled or cancelled, cannot process again&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;duplicate_fulfillment&quot;,&quot;message&quot;:&quot;Order ORD-789 has already been shipped via tracking 1Z999...&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;shipmentId&quot;:&quot;SHP-&apos; + r.nextInt(10000,99999) + &apos;&quot;,&quot;tracking&quot;:&quot;1Z999AA1&quot;,&quot;status&quot;:&quot;shipped&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(r.nextInt(200, 500))
SampleResult.setConnectTime(r.nextInt(8, 40))
SampleResult.setLatency(r.nextInt(40, 150))
