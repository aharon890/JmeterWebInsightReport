        <!-- Sampler 11 -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v3/shopping-cart/{cartId}/items/add?applyPromotions=true&amp;loyaltyTier=PLATINUM&amp;shippingEstimate=true&amp;giftWrapAvailable=true&amp;reserveInventory=300s" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def r = ThreadLocalRandom.current()
