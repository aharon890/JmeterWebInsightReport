      <!-- ==================== LISTENERS ==================== -->

      <!-- Save results to JTL -->
      <ResultCollector guiclass="SimpleDataWriter" testclass="ResultCollector" testname="Save Results to JTL">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
