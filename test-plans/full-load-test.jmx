        <!-- Export Report -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/admin/reports/export">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def rng = ThreadLocalRandom.current()
def delay = rng.nextInt(1000, 3000)
if (rng.nextInt(100) &lt; 20) { delay += rng.nextInt(500, 2000) }
Thread.sleep(delay)
if (rng.nextInt(100) &lt; 10) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage("Internal Server Error")
    SampleResult.setResponseData('{"error":"Report generation failed — out of memory"}', "UTF-8")
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("OK")
    SampleResult.setResponseData('{"reportId":"RPT-' + System.currentTimeMillis() + '","format":"csv","rows":' + rng.nextInt(1000,50000) + '}', "UTF-8")
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setBytes(65536L)
SampleResult.setSentBytes(128)
