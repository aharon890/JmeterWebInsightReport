        <!-- Inventory Check (fast, low error) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/inventory/check">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def rng = ThreadLocalRandom.current()
Thread.sleep(rng.nextInt(20, 100))
if (rng.nextInt(100) &lt; 1) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage("Internal Server Error")
    SampleResult.setResponseData('{"error":"Inventory service down"}', "UTF-8")
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("OK")
    SampleResult.setResponseData('{"sku":"SKU-' + rng.nextInt(10000) + '","available":' + rng.nextInt(0,500) + '}', "UTF-8")
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setBytes(256L)
SampleResult.setSentBytes(64)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
