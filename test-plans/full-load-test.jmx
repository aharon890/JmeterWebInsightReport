        </hashTree>

        <!-- Price Update (fast, moderate error) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PUT /api/pricing/update">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def rng = ThreadLocalRandom.current()
Thread.sleep(rng.nextInt(30, 150))
if (rng.nextInt(100) &lt; 6) {
    def codes = ["409", "422", "500"]
    def msgs = ["Conflict", "Unprocessable Entity", "Internal Server Error"]
    def idx = rng.nextInt(3)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(codes[idx])
    SampleResult.setResponseMessage(msgs[idx])
    SampleResult.setResponseData('{"error":"Price update failed"}', "UTF-8")
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("OK")
    SampleResult.setResponseData('{"updated":true,"newPrice":' + String.format("%.2f", rng.nextDouble(5,500)) + '}', "UTF-8")
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setBytes(512L)
SampleResult.setSentBytes(256)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Sampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Polling Interval">
            <stringProp name="ConstantTimer.delay">150</stringProp>
          </ConstantTimer>
          <hashTree/>
        </hashTree>

