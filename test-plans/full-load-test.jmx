        <!-- Dashboard Stats -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/admin/dashboard">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def rng = ThreadLocalRandom.current()
def delay = rng.nextInt(500, 2000)
Thread.sleep(delay)
if (rng.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("504")
    SampleResult.setResponseMessage("Gateway Timeout")
    SampleResult.setResponseData('{"error":"Dashboard query timed out"}', "UTF-8")
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("OK")
    SampleResult.setResponseData('{"orders":' + rng.nextInt(100,5000) + ',"revenue":' + rng.nextInt(10000,500000) + ',"users":' + rng.nextInt(500,10000) + '}', "UTF-8")
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setBytes(16384L)
SampleResult.setSentBytes(64)
          </stringProp>
