{
  "version": "1.0",
  "testNotes": "## Load Test \u2014 E-Commerce API\n\n### Objective\nValidate the checkout flow under load with 10 concurrent users.\n\n### Environment\n- **Server:** staging-api.example.com\n- **Database:** PostgreSQL 15 (replica set)\n- **CDN:** CloudFront enabled\n\n### Key Observations\n1. Payment processing shows 15% slow-path rate\n2. Search latency spikes during cache rebuilds\n3. Product catalog reads are consistently fast",
  "assertions": [
    {
      "id": "default:p95",
      "description": "p95 must stay under 1000",
      "target": {
        "match": "*",
        "exclude": [
          "GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&minRating=4.5&verified=true",
          "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
        ]
      },
      "metric": "p95",
      "warn": {
        "gt": 800.0
      },
      "fail": {
        "gt": 1000.0
      }
    },
    {
      "id": "default:p99",
      "description": "p99 must stay under 2000",
      "target": {
        "match": "*",
        "exclude": [
          "GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&minRating=4.5&verified=true",
          "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
        ]
      },
      "metric": "p99",
      "warn": {
        "gt": 1600.0
      },
      "fail": {
        "gt": 2000.0
      }
    },
    {
      "id": "default:errorRate",
      "description": "errorRate must stay under 5",
      "target": {
        "match": "*",
        "exclude": [
          "GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&minRating=4.5&verified=true",
          "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
        ]
      },
      "metric": "errorRate",
      "warn": {
        "gt": 4.0
      },
      "fail": {
        "gt": 5.0
      }
    },
    {
      "id": "default:mean",
      "description": "mean must stay under 500",
      "target": {
        "match": "*",
        "exclude": [
          "GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&minRating=4.5&verified=true",
          "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
        ]
      },
