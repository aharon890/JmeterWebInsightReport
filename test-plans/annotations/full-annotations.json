        "sampler": "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
      },
      "metric": "p95",
      "warn": {
        "gt": 1600.0
      },
      "fail": {
        "gt": 2000.0
      }
    },
    {
      "id": "checkout:p99",
      "description": "p99 must stay under 3000",
      "target": {
        "sampler": "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}"
      },
      "metric": "p99",
      "warn": {
        "gt": 2400.0
      },
