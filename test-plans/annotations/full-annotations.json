  "samplerNotes": {
    "POST /api/v2/orders/checkout/process-payment?provider=stripe&method=card&3dsecure=required&idempotencyKey={uuid}": "Includes Stripe 3DS verification \u2014 expect higher latency (300-1200ms). 15% of requests go through slow payment path.",
    "GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&minRating=4.5&verified=true": "Elasticsearch-backed search. Cache rebuild causes periodic spikes.",
    "GET /api/v2/catalog/products/{productId}/variants?includeInventory=true&warehouse=US-WEST-2&currency=USD": "CDN-cached for 60s. Very low latency expected."
  },
  "timelineMarkers": [
    {
      "timestamp": 1700000005000,
      "label": "Ramp-Up Complete",
