        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/notifications" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def random = ThreadLocalRandom.current()
Thread.sleep(random.nextInt(30, 120))
if (random.nextInt(100) &lt; 1) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;503&quot;)
    SampleResult.setResponseMessage(&quot;Service Unavailable&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Notification service down&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;unread&quot;:&apos; + random.nextInt(0, 15) + &apos;,&quot;total&quot;:&apos; + random.nextInt(10, 100) + &apos;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(48)
