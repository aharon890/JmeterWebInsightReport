          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Checkout Flow - Apply Coupon">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom
def random = ThreadLocalRandom.current()
Thread.sleep(random.nextInt(40, 150))
if (random.nextInt(100) &lt; 8) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;400&quot;)
    SampleResult.setResponseMessage(&quot;Bad Request&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Invalid coupon code&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;discount&quot;:15,&quot;code&quot;:&quot;SAVE15&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(96)
            </stringProp>
