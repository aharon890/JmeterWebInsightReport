        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="API-10 /search" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(150, 450)
Thread.sleep(delay)

if (random.nextInt(100) &lt; 6) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;504&quot;)
    SampleResult.setResponseMessage(&quot;Gateway Timeout&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Search index timeout&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    def hits = random.nextInt(0, 500)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;hits&quot;:&apos; + hits + &apos;,&quot;took&quot;:&apos; + delay + &apos;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(96)
