<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Multi Listener Distinct Test — two listeners, two filenames">
      <stringProp name="TestPlan.comments">Fixture for A08. multi-listener-test.jmx has two listeners with NO filename set, so both resolve to the same default path and collide — that is C26/A07. This plan is the other half: two listeners whose Report Filename fields differ, so each owns its own path and neither can warn about the other. Do not pass -Jwebinsight.report.filename to it: a CLI property wins over both fields and collapses the two listeners back onto one name, silently turning this into A07.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="API Users">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,1)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,5)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/health" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
Thread.sleep(random.nextInt(20, 60))

SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;OK&quot;)
SampleResult.setResponseData(&apos;{&quot;status&quot;:&quot;healthy&quot;}&apos;, &quot;UTF-8&quot;)
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <com.jmeterwebinsightreport.report.listener.WebInsightReportListener guiclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListenerGui" testclass="com.jmeterwebinsightreport.report.listener.WebInsightReportListener" testname="Web Insight Report A">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <stringProp name="WebInsightReport.reportFilename">listener-a.html</stringProp>
        <stringProp name="WebInsightReport.reportTitle">LISTENER-A</stringProp>
        <boolProp name="WebInsightReport.generateJunitXml">false</boolProp>
        <objProp>
          <name>saveConfig</name>
