<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Nested Transactions — one transaction run alone and inside another">
      <stringProp name="TestPlan.comments">E31. The shape tails-conversation-flows found (2026-11): &quot;Open the conversation&quot; and &quot;Send and reply&quot; (parent sample on) are a Test Fragment run through Module Controllers, on their own in most sessions and inside &quot;Whole session&quot; (parent sample on) in sessions 1, 6, 11 and 16. The stale-link child fails in sessions 3, 9, 12, 15 and 18, never a nested one. A second, timed thread group leaves &quot;Search the thread&quot; transactions open when the test ends, which JMeter writes without the &quot;Number of samples&quot; message. R07 holds the run report, and its -g rebuild, to the In-test-plan results file. The fixed group alone sends a listener in the plan 56 samples, 5 of them failed.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="Shared transactions" enabled="false"/>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Open the conversation" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET conversation" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">Thread.sleep(6)
          boolean fail = false
          SampleResult.setSuccessful(!fail)
          SampleResult.setResponseCode(fail ? &apos;404&apos; : &apos;200&apos;)
          SampleResult.setResponseMessage(fail ? &apos;Not Found&apos; : &apos;OK&apos;)
          SampleResult.setResponseData(fail ? &apos;{&quot;error&quot;:&quot;no such conversation&quot;}&apos; : &apos;{&quot;ok&quot;:true}&apos;, &apos;UTF-8&apos;)
          SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET messages (latest 40)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">Thread.sleep(5)
          boolean fail = false
          SampleResult.setSuccessful(!fail)
          SampleResult.setResponseCode(fail ? &apos;404&apos; : &apos;200&apos;)
          SampleResult.setResponseMessage(fail ? &apos;Not Found&apos; : &apos;OK&apos;)
          SampleResult.setResponseData(fail ? &apos;{&quot;error&quot;:&quot;no such conversation&quot;}&apos; : &apos;{&quot;ok&quot;:true}&apos;, &apos;UTF-8&apos;)
          SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If this is a failing-child session" enabled="true">
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;failing_child_session&apos;) == &apos;true&apos;)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET conversation (stale link, fails on purpose)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">Thread.sleep(4)
            boolean fail = true
            SampleResult.setSuccessful(!fail)
            SampleResult.setResponseCode(fail ? &apos;404&apos; : &apos;200&apos;)
            SampleResult.setResponseMessage(fail ? &apos;Not Found&apos; : &apos;OK&apos;)
            SampleResult.setResponseData(fail ? &apos;{&quot;error&quot;:&quot;no such conversation&quot;}&apos; : &apos;{&quot;ok&quot;:true}&apos;, &apos;UTF-8&apos;)
            SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Send and reply" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST message" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">Thread.sleep(8)
          boolean fail = false
