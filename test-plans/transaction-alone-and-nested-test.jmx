              <stringProp name="764597751">Test Plan</stringProp>
              <stringProp name="246651820">Nested Transactions — one transaction run alone and inside another</stringProp>
              <stringProp name="2145485072">Shared transactions</stringProp>
              <stringProp name="220371177">Send and reply</stringProp>
            </collectionProp>
          </ModuleController>
          <hashTree/>
        </hashTree>
      </hashTree>
