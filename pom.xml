<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jmeterwebinsightreport</groupId>
    <artifactId>jmeter-web-insight-suite</artifactId>
    <!-- Maven's CI-friendly version: the real number lives in the <revision> property
         below and both modules reference ${revision} in their <parent> block, so a
         release is one edit instead of three kept-in-step-by-hand edits.
         The flatten plugin (see <build>) resolves it in the installed/deployed poms,
         because a consumer's Maven cannot expand our property. -->
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>JMeter Web Insight Suite</name>
    <description>A suite of JMeter plugins for modern, interactive test reporting and monitoring.</description>
    <url>https://github.com/aharon890/JmeterWebInsightReport</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>jmeter-report-core</module>
        <module>jmeter-web-insight-report</module>
    </modules>

    <properties>
        <!-- THE version of the whole suite. This is the only place to change it. -->
        <revision>4.2.23</revision>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- `release` rather than source/target: source/target still compiles against the
             BUILD JDK's class library, so building on a JDK newer than 21 can link against
             APIs that do not exist on 21 and the jar then fails at runtime on the Java version
             the docs promise. `release` pins the API level too. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Dependency versions -->
        <jmeter.version>5.6.3</jmeter.version>
        <!-- Jackson is JMeter's own copy (provided, never shaded): this must be the version
             JMeter ships in lib/, or the tests run on a Jackson no user ever has. A newer
             databind beside JMeter's jackson-core fails with NoSuchMethodError. Dependabot is
             told to leave it alone in .github/dependabot.yml. -->
        <jackson.version>2.16.1</jackson.version>
        <commons-math3.version>3.6.1</commons-math3.version>
        <slf4j.version>1.7.36</slf4j.version>
        <thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
        <junit.version>5.10.2</junit.version>

        <!-- Plugin versions -->
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <maven-compiler-plugin.version>3.12.1</maven-compiler-plugin.version>
        <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.jmeterwebinsightreport</groupId>
                <artifactId>jmeter-report-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JMeter (provided — present at runtime in JMeter's classpath) -->
            <dependency>
                <groupId>org.apache.jmeter</groupId>
                <artifactId>ApacheJMeter_core</artifactId>
                <version>${jmeter.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.jmeter</groupId>
                <artifactId>ApacheJMeter_components</artifactId>
                <version>${jmeter.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- JMeter's functions (__P, __property, __time, ...), test only: the listener panel
                 evaluates its fields with CompoundVariable, which finds the functions through
                 ServiceLoader, and a test of that evaluation needs them on the classpath. At run
                 time they are JMeter's own lib/ext/ApacheJMeter_functions.jar. -->
            <dependency>
                <groupId>org.apache.jmeter</groupId>
                <artifactId>ApacheJMeter_functions</artifactId>
                <version>${jmeter.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Jackson (provided — JMeter bundles it) -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Commons Math (provided — JMeter bundles it) -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-math3</artifactId>
                <version>${commons-math3.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- SLF4J (provided — JMeter bundles it) -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Thymeleaf (compile — shaded into fat JAR) -->
            <dependency>
                <groupId>org.thymeleaf</groupId>
                <artifactId>thymeleaf</artifactId>
                <version>${thymeleaf.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Rewrites ${revision} to a literal version in the pom that gets installed and
                 deployed. Without this the published pom would still say ${revision}, which
                 nothing downstream can resolve — the property only exists in OUR build.
                 resolveCiFriendliesOnly touches exactly those placeholders and leaves the rest
                 of the pom alone. Inherited by both modules. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <!-- Removes .flattened-pom.xml on `mvn clean` so it never goes stale. -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
