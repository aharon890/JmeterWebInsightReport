<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jmeterwebinsightreport</groupId>
        <artifactId>jmeter-web-insight-suite</artifactId>
        <!-- ${revision} lives in the parent pom's properties — the single place the
             suite version is defined. Do not hardcode a number here. -->
        <version>${revision}</version>
    </parent>

    <artifactId>jmeter-web-insight-report</artifactId>
    <packaging>jar</packaging>

    <name>JMeter Web Insight Report</name>
    <description>Modern HTML report generator plugin for Apache JMeter — supports both -g -o pipeline and GUI listener mode.</description>

    <dependencies>
        <!-- Internal core module -->
        <dependency>
            <groupId>com.jmeterwebinsightreport</groupId>
            <artifactId>jmeter-report-core</artifactId>
        </dependency>

        <!-- JMeter (provided — present at runtime) -->
        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>ApacheJMeter_core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>ApacheJMeter_components</artifactId>
        </dependency>

        <!-- Jackson (provided — JMeter bundles it) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SLF4J (provided — JMeter bundles it) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Thymeleaf (compile — shaded into fat JAR) -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The repository's NOTICE and LICENSE go into the JAR's META-INF: the JAR
                 redistributes ECharts and the shaded libraries, and Apache-2.0 asks for their
                 notices to travel with it. ECharts is a static resource, not a dependency, so
                 nothing else would carry its NOTICE in. -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>NOTICE</include>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- Shade plugin — produces fat JAR with core + t-digest + thymeleaf -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.jmeterwebinsightreport:jmeter-report-core</include>
                                    <include>com.tdunning:t-digest</include>
                                    <include>org.thymeleaf:*</include>
                                    <include>org.attoparser:*</include>
                                    <include>org.unbescape:*</include>
                                    <include>ognl:*</include>
                                    <include>org.javassist:*</include>
                                </includes>
                            </artifactSet>
                            <!--
                                The fat JAR is dropped into JMeter's shared lib/ext, whose
                                classloader is flat. Shipping Thymeleaf/OGNL/Javassist at their
                                original coordinates means another lib/ext plugin (or a future
                                JMeter) bundling a different version resolves to whichever jar
                                wins the scan order, producing NoSuchMethodError/LinkageError at
                                report-generation time for this plugin or the other one.

                                Relocate every bundled third-party library under one prefix so
                                nothing outside this JAR can collide with it. Thymeleaf's OGNL
                                usage survives because all of them move together.

                                jmeter-report-core is deliberately NOT relocated: it stays under
                                com.jmeterwebinsightreport alongside the listener and exporter,
                                whose fully-qualified names appear in JMX files and in
                                reportgenerator.properties.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>org.thymeleaf</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.thymeleaf</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.attoparser</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.attoparser</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.unbescape</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.unbescape</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>ognl</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.ognl</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javassist</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.javassist</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.tdunning</pattern>
                                    <shadedPattern>com.jmeterwebinsightreport.shaded.tdunning</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <JMeter-Skip-Class-Scanning>true</JMeter-Skip-Class-Scanning>
                                        <!-- java -jar <plugin jar> runs the collector (decision 13): a JDK-only
                                             launcher that loads JMeter's lib/ beside it. -->
                                        <Main-Class>com.jmeterwebinsightreport.WirCollectLauncher</Main-Class>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- attoparser and unbescape each ship a META-INF/NOTICE.txt; without
                                     this, one overwrote the other. Merged beside ours, no header. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
