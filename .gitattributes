# Normalize line endings so the same checkout works on Windows, macOS and Linux.
# Without this, a Windows contributor with core.autocrlf=true commits CRLF and
# the shell scripts die on macOS with: bad interpreter: /usr/bin/env bash^M
* text=auto eol=lf

# Windows batch files must keep CRLF — cmd.exe mis-parses LF-only .bat files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must always be LF, even when checked out on Windows.
*.sh text eol=lf

# Test fixtures are parsed byte-for-byte; pin them.
*.jtl text eol=lf
*.jmx text eol=lf

# Binary — never touch.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tgz binary
