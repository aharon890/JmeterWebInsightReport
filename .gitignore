# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
.vscode/
*.code-workspace
.nb-gradle/
nbproject/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
*.jar
!.mvn/wrapper/*.jar
*.war
*.ear
*.class

# Logs
*.log
hs_err_pid*

# Python bytecode — the fixture/report helper scripts under test-plans/scripts
# are imported as modules, so CPython drops a __pycache__ next to them.
__pycache__/
*.py[cod]

# Test artifacts — JTL result files
*.jtl
# But keep JTL test fixtures used by unit tests
!jmeter-report-core/src/test/resources/jtl/*.jtl

test-plans/smoke-report-output/
test-plans/runs/

# Test results (generated by test suite runs)
test-results/

# Playwright runtime artifacts.
#
# package-lock.json is deliberately NOT here. It was classed as a runtime artifact,
# but it is the opposite: it is the only record of which Playwright actually ran.
# Without it `npm ci` is impossible, CI re-resolves ^1.58.0 on every run, and a
# browser-behaviour change in a new patch release reaches CI before any developer
# machine — turning "the report renders correctly" into a moving target.
test-plans/playwright/node_modules/
test-plans/playwright/test-results/
test-plans/playwright/playwright-report/

# JMeter installation (local testing)
apache-jmeter-*/

# Local dev scripts (root-level only) — but keep the tracked build/deploy
# tooling and its shared library, which every test runner sources.
/scripts/*
!/scripts/lib/
!/scripts/*.sh
!/scripts/*.bat

# Temp / scratch — temp/ holds ad-hoc review and audit output (hundreds of files,
# including a vendored sbadmin2 tree); one `git add .` away from being committed.
tmp/
temp/

# Screenshots
JmeterWebInsightReport_Screenshots/

# Generated report files in root — a run with no -Jwebinsight.report.output writes to the
# working directory, which for anyone launching from the project root is here. All four
# artifacts of one run, not just the two that were listed: the JUnit XML and the external-data
# payload land beside the HTML and were showing up as untracked noise in every git status.
/web-insight-report.html
/web-insight-report.json
/web-insight-report.xml
/web-insight-data.js

# The publish lock, wherever it lands — no leading slash, because it is created in the OUTPUT
# directory and a manual run points that anywhere.
#
# It is never deleted, by design: the lock is held against the inode, not the path, so a process
# that unlinked it and recreated it would be locking a different file from the one an in-flight
# writer holds. Both would succeed, both would believe they had exclusive access, and two runs
# would publish into one directory at once — which is the thing the lock exists to prevent. The
# price is a dotfile that stays behind, so it is ignored rather than cleaned up.
.web-insight-publish.lock

# Claude Code — local settings stay out, shared skills go in.
# `.claude/*` rather than `.claude/`: git cannot re-include anything beneath an
# excluded DIRECTORY, so ignoring the directory itself makes the negation below
# silently do nothing.
.claude/*
!.claude/skills/

# flatten-maven-plugin output (CI-friendly ${revision} resolution)
.flattened-pom.xml
**/.flattened-pom.xml
